/* Enhanced About Page Styling */
.section {
  padding: 4rem 0;
  background-color: #f9fafb;
}

.infoC {
  display: flex;
  flex-direction: row;
  gap: 3rem;
  align-items: center;
  margin-bottom: 5rem;
  background-color: white;
  border-radius: 12px;
  padding: 3rem;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.infoC::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 5px;
  background: linear-gradient(90deg, #dc2626, #ef4444);
}

.texts {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.texts p {
  line-height: 1.8;
  color: #4b5563;
  margin: 0;
}

.texts p:first-child {
  color: #dc2626;
  font-size: 1.1rem;
  font-weight: 500;
}

.texts p:nth-child(2),
.texts p:nth-child(3) {
  font-size: 1rem;
}

.imageB {
  flex: 1;
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  transition: transform 0.3s ease;
}

.imageB:hover {
  transform: translateY(-10px);
}

.imageB img {
  width: 100%;
  height: auto;
  object-fit: cover;
  border-radius: 12px;
  transition: transform 0.5s ease;
}

.imageB:hover img {
  transform: scale(1.05);
}

.globe {
  padding: 3rem 0;
  text-align: center;
}

.globe h1 {
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 3rem;
  color: #1f2937;
  position: relative;
  display: inline-block;
}

.globe h1::after {
  content: '';
  position: absolute;
  bottom: -15px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 4px;
  background: linear-gradient(90deg, #dc2626, #ef4444);
  border-radius: 2px;
}

.modes {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  margin-bottom: 4rem;
}

.box {
  background-color: white;
  border-radius: 12px;
  padding: 2rem;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.box::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background-color: #dc2626;
  transition: all 0.3s ease;
}

.box:hover {
  transform: translateY(-10px);
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

.box:hover::before {
  width: 100%;
  height: 4px;
}

.image {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  background-color: rgba(220, 38, 38, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  transition: all 0.3s ease;
}

.box:hover .image {
  background-color: white;
}

.image i {
  font-size: 2rem;
  color: #dc2626;
  transition: all 0.3s ease;
}

.box h2 {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 1rem;
  color: #1f2937;
  transition: all 0.3s ease;
}

.box:hover h2 {
  color: white;
}

.globeInfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3rem;
  margin-top: 3rem;
}

.holding {
  position: relative;
  width: 300px;
  height: 300px;
}

.rotate-globe {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background-color: #dc2626;
  background-blend-mode: overlay;
  animation: rotate 25s linear infinite;
}

@keyframes rotate {
  0% {
    background-position: 0 0;
  }
  100% {
    background-position: 4098px 0;
  }
}

.about-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  width: 100%;
  max-width: 800px;
}

.about-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  background-color: white;
  padding: 1.5rem;
  border-radius: 12px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.about-item:hover {
  transform: translateX(10px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
}

.about-icon {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background-color: rgba(220, 38, 38, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.about-icon i {
  color: #dc2626;
  font-size: 0.8rem;
}

.about-text {
  margin: 0;
  font-size: 1rem;
  line-height: 1.7;
  color: #4b5563;
}

/* Responsive Design */
@media (max-width: 992px) {
  .infoC {
    flex-direction: column;
    padding: 2rem;
  }
  
  .imageB {
    width: 100%;
  }
  
  .modes {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
}

@media (max-width: 768px) {
  .section {
    padding: 3rem 0;
  }
  
  .globe h1 {
    font-size: 2rem;
  }
  
  .modes {
    grid-template-columns: 1fr;
  }
  
  .holding {
    width: 250px;
    height: 250px;
  }
  
  .rotate-globe {
    width: 150px;
    height: 150px;
  }
}

@media (max-width: 576px) {
  .infoC {
    padding: 1.5rem;
  }
  
  .globe h1 {
    font-size: 1.8rem;
  }
  
  .box {
    padding: 1.5rem;
  }
  
  .about-item {
    padding: 1rem;
  }
}
