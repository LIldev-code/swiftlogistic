/* Enhanced Warehouse Page Styling */
.warehouseContainer {
  padding: 4rem 0;
  background-color: #f9fafb;
}

.warehouseIntro {
  max-width: 900px;
  margin: 0 auto 3rem;
  background-color: white;
  border-radius: 12px;
  padding: 2.5rem;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.warehouseIntro::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 5px;
  background: linear-gradient(90deg, #dc2626, #ef4444);
}

.introText {
  font-size: 1.1rem;
  line-height: 1.8;
  color: #4b5563;
  margin-bottom: 1.5rem;
}

.storage {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  margin: 3rem 0;
}

.box {
  background-color: white;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.box:hover {
  transform: translateY(-10px);
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

.imb {
  width: 100%;
  height: 220px;
  overflow: hidden;
}

.imb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.box:hover .imb img {
  transform: scale(1.1);
}

.box h2 {
  padding: 1.5rem 1.5rem 0.5rem;
  font-size: 1.2rem;
  font-weight: 600;
  color: #1f2937;
  text-transform: uppercase;
  margin: 0;
  position: relative;
}

.box h2::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 1.5rem;
  width: 50px;
  height: 3px;
  background-color: #dc2626;
  transition: width 0.3s ease;
}

.box:hover h2::after {
  width: 80px;
}

.box p {
  padding: 1rem 1.5rem 1.5rem;
  font-size: 0.95rem;
  line-height: 1.7;
  color: #4b5563;
  margin: 0;
  flex-grow: 1;
}

.move {
  display: flex;
  flex-direction: row;
  gap: 3rem;
  align-items: center;
  margin: 4rem 0;
  background-color: white;
  border-radius: 12px;
  padding: 3rem;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
}

.left {
  flex: 1;
}

.left h1 {
  font-size: 2rem;
  font-weight: 700;
  color: #1f2937;
  margin: 0 0 1.5rem;
  text-transform: capitalize;
  position: relative;
  display: inline-block;
}

.left h1::after {
  content: '';
  position: absolute;
  bottom: -10px;
  left: 0;
  width: 70px;
  height: 4px;
  background-color: #dc2626;
  border-radius: 2px;
}

.left p {
  font-size: 1rem;
  line-height: 1.8;
  color: #4b5563;
  margin-bottom: 2rem;
}

.left ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 1rem;
}

.left ul li {
  position: relative;
  padding-left: 1.5rem;
  font-size: 1rem;
  color: #4b5563;
  margin-bottom: 0.5rem;
}

.left ul li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #dc2626;
}

.right {
  flex: 1;
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

.right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 12px;
}

.warehouseFeatures {
  margin-top: 4rem;
}

.featuresTitle {
  text-align: center;
  font-size: 2rem;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 3rem;
  position: relative;
  display: inline-block;
}

.featuresTitle::after {
  content: '';
  position: absolute;
  bottom: -15px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 4px;
  background: linear-gradient(90deg, #dc2626, #ef4444);
  border-radius: 2px;
}

.featureGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
}

.featureCard {
  background-color: white;
  border-radius: 12px;
  padding: 2rem;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.featureCard:hover {
  transform: translateY(-10px);
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

.featureIcon {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background-color: rgba(220, 38, 38, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1.5rem;
}

.featureIcon i {
  font-size: 1.5rem;
  color: #dc2626;
}

.featureTitle {
  font-size: 1.2rem;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 1rem;
}

.featureDescription {
  font-size: 0.95rem;
  line-height: 1.7;
  color: #4b5563;
}

/* Responsive Design */
@media (max-width: 992px) {
  .storage {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }
  
  .move {
    flex-direction: column;
    padding: 2rem;
  }
  
  .right {
    width: 100%;
    margin-top: 2rem;
  }
}

@media (max-width: 768px) {
  .warehouseContainer {
    padding: 3rem 0;
  }
  
  .warehouseIntro {
    padding: 2rem;
  }
  
  .storage {
    grid-template-columns: 1fr;
  }
  
  .left h1 {
    font-size: 1.8rem;
  }
  
  .left ul {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 576px) {
  .warehouseIntro {
    padding: 1.5rem;
  }
  
  .box h2 {
    font-size: 1.1rem;
  }
  
  .move {
    padding: 1.5rem;
  }
}
